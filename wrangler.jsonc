{
  // HeadsUp Middletown — tells Cloudflare to run _worker.js for /api/* and serve the site files.
  "name": "headsupmiddletown",
  "main": "_worker.js",
  "compatibility_date": "2025-09-01",
  "keep_vars": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/tiles/*"]
  }
}
